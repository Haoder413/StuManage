<view class="page login-page">
  <view class="login-hero">
    <view class="title">淘淘数学</view>
    <view class="subtitle">家长端小程序试用版</view>
  </view>

  <view class="card form-card">
    <view class="field-label">账号</view>
    <input class="input" placeholder="手机号或邮箱" value="{{identifier}}" bindinput="onIdentifierInput" />

    <view class="field-label">密码</view>
    <input class="input" password placeholder="请输入密码" value="{{password}}" bindinput="onPasswordInput" />

    <checkbox-group class="privacy-group" bindchange="onPrivacyChange">
      <label class="privacy-label">
        <checkbox value="accepted" checked="{{privacyAccepted}}" color="#2563eb" />
        <text>我已阅读并同意设备登录与隐私说明</text>
      </label>
    </checkbox-group>
    <view class="privacy-notice">
      为保障账号安全，会记录设备类型、系统、IP、登录时间和最近活跃时间，历史记录保存 90 天。
    </view>

    <button class="button login-button" loading="{{loading}}" disabled="{{loading || !privacyAccepted}}" bindtap="login">登录</button>
    <view wx:if="{{message}}" class="message">{{message}}</view>
  </view>
</view>
