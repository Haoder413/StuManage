<view class="page">
  <view class="header">
    <view class="title">资料中心</view>
    <view class="subtitle">一套资料集中查看学生版与答案版</view>
  </view>

  <input class="search-input" value="{{query}}" placeholder="搜索标题、文件名、标签或年级" bindinput="onQueryInput" />
  <scroll-view scroll-x class="filter-scroll">
    <view class="filter-row">
      <picker range="{{courseOptions}}" range-key="name" value="{{courseIndex}}" data-field="course" bindchange="onFilterChange"><view class="filter-chip">{{courseOptions[courseIndex].name}}</view></picker>
      <picker range="{{gradeOptions}}" value="{{gradeIndex}}" data-field="grade" bindchange="onFilterChange"><view class="filter-chip">{{gradeOptions[gradeIndex]}}</view></picker>
      <input class="year-filter-input" type="number" value="{{yearInput}}" placeholder="{{year === 'unset' ? '未设置年份' : '全部年份'}}" confirm-type="search" bindinput="onYearInput" bindconfirm="applyYearFilter" bindblur="applyYearFilter" />
      <view class="filter-chip" bindtap="filterUnsetYear">{{year === 'unset' ? '全部年份' : '未设置年份'}}</view>
      <picker range="{{subjectOptions}}" value="{{subjectIndex}}" data-field="subject" bindchange="onFilterChange"><view class="filter-chip">{{subjectOptions[subjectIndex]}}</view></picker>
      <picker range="{{kindOptions}}" range-key="name" value="{{kindIndex}}" data-field="kind" bindchange="onFilterChange"><view class="filter-chip">{{kindOptions[kindIndex].name}}</view></picker>
    </view>
  </scroll-view>

  <view wx:if="{{loading}}" class="card muted">加载中...</view>
  <view wx:elif="{{loadError && resources.length === 0}}" class="card muted">{{loadError}}</view>
  <view wx:elif="{{resources.length === 0}}" class="card muted">{{query || courseId || grade || year || subject || resourceKind ? '没有符合条件的资料' : '老师暂未向课程同步资料'}}</view>

  <view wx:for="{{resources}}" wx:key="id" class="card resource-card">
    <view class="resource-head">
      <view class="resource-title">{{item.title}}</view>
      <view class="kind-badge">{{item.kindText}}</view>
    </view>
    <view class="subtitle">{{item.grade || '未设置年级'}} · {{item.year ? item.year + '年' : '未设置年份'}} · {{item.subject || '未设置科目'}}</view>
    <view class="tag-row"><text wx:for="{{item.tags}}" wx:for-item="tag" wx:key="*this" class="tag">{{tag}}</text></view>
    <view wx:for="{{item.files}}" wx:for-item="file" wx:key="id" class="file-row">
      <text class="role-badge role-{{file.role}}">{{file.roleText}}</text>
      <text class="file-name">{{file.originalName}}</text>
      <button wx:if="{{file.canPreview}}" size="mini" bindtap="preview" data-url="{{file.previewUrl}}" data-extension="{{file.extension}}" data-group-id="{{item.id}}" data-file-id="{{file.id}}">预览</button>
      <button wx:if="{{file.canDownload}}" size="mini" bindtap="download" data-url="{{file.downloadUrl}}" data-extension="{{file.extension}}" data-group-id="{{item.id}}" data-file-id="{{file.id}}">下载</button>
    </view>
  </view>

  <button wx:if="{{hasNextPage}}" class="load-more" loading="{{loadingMore}}" bindtap="loadMore">{{loadingMore ? '加载中…' : '加载更多'}}</button>
  <view wx:if="{{resources.length > 0 && !hasNextPage}}" class="end-text">已显示全部 {{total}} 套资料</view>
</view>
