.header { margin-bottom: 24rpx; }
.search-input { box-sizing: border-box; width: 100%; margin-bottom: 18rpx; padding: 22rpx 26rpx; border: 2rpx solid #e2e8f0; border-radius: 18rpx; background: #fff; font-size: 28rpx; }
.filter-scroll { margin-bottom: 20rpx; white-space: nowrap; }
.filter-row { display: flex; gap: 14rpx; }
.filter-chip { padding: 14rpx 22rpx; border: 2rpx solid #dbeafe; border-radius: 999rpx; background: #eff6ff; color: #0369a1; font-size: 24rpx; }
.resource-card { padding: 28rpx; }
.resource-head { display: flex; align-items: flex-start; gap: 16rpx; }
.resource-title { flex: 1; font-size: 32rpx; font-weight: 800; color: #0f172a; }
.kind-badge { padding: 6rpx 14rpx; border-radius: 999rpx; background: #e0f2fe; color: #0369a1; font-size: 22rpx; font-weight: 700; }
.tag-row { display: flex; flex-wrap: wrap; gap: 10rpx; margin: 18rpx 0; }
.tag { padding: 5rpx 12rpx; border-radius: 8rpx; background: #f1f5f9; color: #64748b; font-size: 22rpx; }
.file-row { display: flex; align-items: center; gap: 12rpx; margin-top: 14rpx; padding: 16rpx; border-radius: 14rpx; background: #f8fafc; }
.role-badge { flex: none; padding: 6rpx 10rpx; border-radius: 8rpx; background: #e2e8f0; color: #475569; font-size: 21rpx; font-weight: 700; }
.role-student { background: #dbeafe; color: #1d4ed8; }
.role-answer { background: #ffedd5; color: #c2410c; }
.file-name { min-width: 0; flex: 1; overflow: hidden; color: #475569; font-size: 23rpx; text-overflow: ellipsis; white-space: nowrap; }
.file-row button { flex: none; margin: 0; }
.load-more { margin: 24rpx auto; background: #fff; color: #0284c7; font-size: 26rpx; }
.end-text { padding: 24rpx 0 12rpx; text-align: center; color: #94a3b8; font-size: 23rpx; }
